+ExactMatchResult HashMemoryMap::MatchFloat32Bits(
+    MemoryMap& actual2, uint64_t base, uint64_t count, FILE* report) {
+  HashMemoryMap& actual = dynamic_cast<HashMemoryMap&>(actual2);
+  ExactMatchResult result{true, 0, 0};
+  for (uint64_t index = 0; index < count; ++index) {
+    const uint64_t address = base + index * sizeof(float);
+    const uint64_t packet_address = FormatAddr(address);
+    if (!CheckAddr(packet_address) || !actual.CheckAddr(packet_address)) {
+      result.matched = false;
+      ++result.mismatched;
+      if (report != nullptr) {
+        std::fprintf(report,
+                     "M2NDP_STRICT_MISMATCH index=%llu address=0x%llx "
+                     "reason=missing\n",
+                     static_cast<unsigned long long>(index),
+                     static_cast<unsigned long long>(address));
+      }
+      continue;
+    }
+    VectorData expected_packet = Load(packet_address);
+    VectorData actual_packet = actual.Load(packet_address);
+    const int element = (address % PACKET_SIZE) / sizeof(float);
+    if (expected_packet.GetType() != FLOAT32 ||
+        actual_packet.GetType() != FLOAT32) {
+      result.matched = false;
+      ++result.mismatched;
+      if (report != nullptr) {
+        std::fprintf(report,
+                     "M2NDP_STRICT_MISMATCH index=%llu address=0x%llx "
+                     "reason=type\n",
+                     static_cast<unsigned long long>(index),
+                     static_cast<unsigned long long>(address));
+      }
+      continue;
+    }
+    const float expected_value = expected_packet.GetFloatData(element);
+    const float actual_value = actual_packet.GetFloatData(element);
+    uint32_t expected_bits = 0;
+    uint32_t actual_bits = 0;
+    std::memcpy(&expected_bits, &expected_value, sizeof(expected_bits));
+    std::memcpy(&actual_bits, &actual_value, sizeof(actual_bits));
+    ++result.compared;
+    if (expected_bits != actual_bits) {
+      result.matched = false;
+      ++result.mismatched;
+      if (report != nullptr) {
+        std::fprintf(report,
+                     "M2NDP_STRICT_MISMATCH index=%llu address=0x%llx "
+                     "expected=0x%08x actual=0x%08x\n",
+                     static_cast<unsigned long long>(index),
+                     static_cast<unsigned long long>(address), expected_bits,
+                     actual_bits);
+      }
+    }
+  }
+  return result;
+}
+
+void HashMemoryMap::DumpFloat32Bits(uint64_t base, uint64_t count,
+                                    const std::string& path) {
+  std::ofstream output(path, std::ios::binary | std::ios::trunc);
+  if (!output.good())
+    throw std::runtime_error("cannot open strict float32 dump");
+  for (uint64_t index = 0; index < count; ++index) {
+    const uint64_t address = base + index * sizeof(float);
+    const uint64_t packet_address = FormatAddr(address);
+    if (!CheckAddr(packet_address))
+      throw std::runtime_error("strict float32 dump address missing");
+    VectorData packet = Load(packet_address);
+    if (packet.GetType() != FLOAT32)
+      throw std::runtime_error("strict float32 dump type mismatch");
+    const int element = (address % PACKET_SIZE) / sizeof(float);
+    const float value = packet.GetFloatData(element);
+    uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    const unsigned char encoded[4] = {
+        static_cast<unsigned char>(bits),
+        static_cast<unsigned char>(bits >> 8),
+        static_cast<unsigned char>(bits >> 16),
+        static_cast<unsigned char>(bits >> 24),
+    };
+    output.write(reinterpret_cast<const char*>(encoded), sizeof(encoded));
+  }
+  output.flush();
+  if (!output.good())
+    throw std::runtime_error("strict float32 dump write failed");
+}
