--- a/main_wrapper.c
+++ b/main_wrapper.c
@@ -4,0 +5 @@
+#include <string.h>
@@ -5,0 +7 @@
+#include "mcf_capture.h"
@@ -48 +50,35 @@
-    /* Call the original main_ptr function */
+    const char *input = NULL;
+    const char *output_root = NULL;
+    int position;
+    int capture_enabled = 0;
+
+#ifdef MCF_CAPTURE_EVENTS
+    capture_enabled = 1;
+#endif
+
+    for (position = 1; position < argc; ++position) {
+        if (strcmp(argv[position], "--input") == 0) {
+            if (++position >= argc) {
+                fprintf(stderr, "missing --input value\n");
+                return 2;
+            }
+            input = argv[position];
+        } else if (strcmp(argv[position], "--output-root") == 0) {
+            if (++position >= argc) {
+                fprintf(stderr, "missing --output-root value\n");
+                return 2;
+            }
+            output_root = argv[position];
+        } else {
+            fprintf(stderr, "unknown argument: %s\n", argv[position]);
+            return 2;
+        }
+    }
+    if (!input || !output_root) {
+        fprintf(stderr, "--input and --output-root are required\n");
+        return 2;
+    }
+    if (mcf_capture_configure(input, output_root, capture_enabled)) {
+        fprintf(stderr, "cannot configure MCF capture harness\n");
+        return 1;
+    }
