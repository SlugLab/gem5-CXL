diff --git a/pbeampp.c b/pbeampp.c
index 976cc42e01..f5caec4e31 100644
--- a/pbeampp.c
+++ b/pbeampp.c
@@ -28,0 +29 @@ Copyright (c) 2003-2005 Andreas Loebel.
+#include "mcf_capture.h"
@@ -161,0 +163 @@ arc_t *primal_bea_mpp( m, arcs, stop_arcs, red_cost_of_bea )
+    long initialize_in = initialize;
@@ -200,0 +203,15 @@ arc_t *primal_bea_mpp( m, arcs, stop_arcs, red_cost_of_bea )
+    if( mcf_capture_pricing_begin(
+            m, arcs, stop_arcs, (long)NR_GROUP_STATE,
+            (long)GROUP_POS_STATE, initialize_in, basket_size ) )
+    {
+        printf( "cannot capture MCF pricing begin\n" );
+        exit(-1);
+    }
+    for( i = 1; i <= basket_size; ++i )
+        if( mcf_capture_pricing_basket(
+                0, i, perm[i]->a, perm[i]->cost, perm[i]->abs_cost ) )
+        {
+            printf( "cannot capture MCF pricing live-in basket\n" );
+            exit(-1);
+        }
+
@@ -210,0 +228,6 @@ arc_t *primal_bea_mpp( m, arcs, stop_arcs, red_cost_of_bea )
+            if( mcf_capture_pricing_scan_live_in(
+                    arc, (long)GROUP_POS_STATE, arcs_priced ) )
+            {
+                printf( "cannot capture MCF pricing scan live-in\n" );
+                exit(-1);
+            }
@@ -225,0 +249,8 @@ arc_t *primal_bea_mpp( m, arcs, stop_arcs, red_cost_of_bea )
+        if( mcf_capture_pricing_end(
+                (arc_t *)0, *red_cost_of_bea, arcs_priced,
+                (long)NR_GROUP_STATE, (long)GROUP_POS_STATE,
+                initialize, basket_size ) )
+        {
+            printf( "cannot capture MCF pricing end\n" );
+            exit(-1);
+        }
@@ -234,0 +266,15 @@ arc_t *primal_bea_mpp( m, arcs, stop_arcs, red_cost_of_bea )
+    for( i = 1; i <= basket_size; ++i )
+        if( mcf_capture_pricing_basket(
+                1, i, perm[i]->a, perm[i]->cost, perm[i]->abs_cost ) )
+        {
+            printf( "cannot capture MCF pricing live-out basket\n" );
+            exit(-1);
+        }
+    if( mcf_capture_pricing_end(
+            perm[1]->a, *red_cost_of_bea, arcs_priced,
+            (long)NR_GROUP_STATE, (long)GROUP_POS_STATE,
+            initialize, basket_size ) )
+    {
+        printf( "cannot capture MCF pricing end\n" );
+        exit(-1);
+    }
