diff --git a/main_wrapper.c b/main_wrapper.c
index dd442c6d19..26dcbdb992 100644
--- a/main_wrapper.c
+++ b/main_wrapper.c
@@ -26,0 +27,2 @@ void remote(arc_t *arc, long *basket_size, BASKET *perm[])
+    int candidate;
+    long basket_slot = -1;
@@ -29,0 +32,3 @@ void remote(arc_t *arc, long *basket_size, BASKET *perm[])
+    candidate =
+        ((red_cost < 0) && (arc->ident == AT_LOWER)) ||
+        ((red_cost > 0) && (arc->ident == AT_UPPER));
@@ -40,0 +46 @@ void remote(arc_t *arc, long *basket_size, BASKET *perm[])
+            basket_slot = *basket_size;
@@ -45,0 +52,5 @@ void remote(arc_t *arc, long *basket_size, BASKET *perm[])
+    if (mcf_capture_pricing_candidate_observed(
+            arc, red_cost, candidate, basket_slot)) {
+        fprintf(stderr, "cannot capture MCF pricing candidate result\n");
+        exit(-1);
+    }
diff --git a/implicit.c b/implicit.c
index 5f59426361..f61ed6c2ff 100644
--- a/implicit.c
+++ b/implicit.c
@@ -242,0 +243,2 @@ long price_out_impl( net )
+    int capture_decision;
+    arc_t *capture_slot;
@@ -251,0 +254,6 @@ long price_out_impl( net )
+    if( mcf_capture_price_out_begin( net ) )
+    {
+        printf( "cannot capture MCF price-out begin\n" );
+        exit(-1);
+    }
+
@@ -322,0 +331,8 @@ long price_out_impl( net )
+            capture_decision = 0;
+            capture_slot = (arc_t *)NULL;
+            if( mcf_capture_price_out_candidate(
+                    tail, head, arc_cost, red_cost ) )
+            {
+                printf( "cannot capture MCF price-out candidate\n" );
+                exit(-1);
+            }
@@ -330,0 +347,2 @@ long price_out_impl( net )
+                    capture_decision = 1;
+                    capture_slot = arcnew + new_arcs - 1;
@@ -332,0 +351 @@ long price_out_impl( net )
+                {
@@ -334,0 +354,9 @@ long price_out_impl( net )
+                    capture_decision = 2;
+                    capture_slot = arcnew;
+                }
+            }
+            if( mcf_capture_price_out_decision(
+                    capture_decision, capture_slot, tail, head ) )
+            {
+                printf( "cannot capture MCF price-out decision\n" );
+                exit(-1);
@@ -371,0 +400,6 @@ long price_out_impl( net )
+    if( mcf_capture_price_out_end( net, new_arcs ) )
+    {
+        printf( "cannot capture MCF price-out end\n" );
+        exit(-1);
+    }
